on early-init
    write /proc/sys/kernel/kptr_restrict 0

# this will make sure you have /data ready and then you try to create the dir.
on post-fs-data
    # Create directory for Graphics applications
    mkdir /data/vendor/gpu 0777 system system
    # Create directory for SCVE applications
    mkdir /data/vendor/scve 0777 system system

# Coresight early boot service
service cs-early-boot /vendor/bin/sh /vendor/bin/init.qcom.debug.sh
    class core
    user root
    oneshot
    seclabel u:r:qti-testscripts:s0

on property:sys.boot_completed=1
    start cs-post-boot

# This is for test purpose: to create veth interfaces and configure the params.
service vendor.vethconfig /vendor/bin/init.veth_ipa_config.sh
    user root
    group root system
    disabled
    oneshot

service qti-testscripts /system/bin/sh /product/etc/init.qcom.testscripts.sh
    class late_start
    user root
    disabled
    oneshot
    seclabel u:r:qti-testscripts:s0

on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /system/bin/ifconfig VETH0 up
    exec u:r:su:s0 root root -- /system/bin/ip link add link VETH0 name VETH0_44 type vlan id 44
    exec u:r:su:s0 root root -- /system/bin/ip link add link VETH0 name VETH0_45 type vlan id 45
    exec u:r:su:s0 root root -- /system/bin/ip link add link VETH0 name VETH0_46 type vlan id 46
    exec u:r:su:s0 root root -- /system/bin/ifconfig VETH0_44 up
    exec u:r:su:s0 root root -- /system/bin/ifconfig VETH0_45 up
    start vendor.vethconfig
    start qti-testscripts

on property:sys.vendor.dbg.coresight.enable=1
    write /mnt/vendor/persist/coresight/enable 1

on property:sys.vendor.dbg.coresight.enable=0
    write /mnt/vendor/persist/coresight/enable 0

service DiagDaemon /system/vendor/bin/diag_socket_log -f /sdcard/ipaddress.txt
    class late_start
    oneshot
    disabled
    user root
    group root system log diag net_raw
